{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "noEmit": true,
    "allowJs": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "miniprogram-api-typings"
    ]
  },
  "include": [
    "app.ts",
    "common/**/*.ts",
    "config/**/*.ts",
    "custom-tab-bar/**/*.ts",
    "pages/**/*.ts",
    "packages/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "miniprogram_npm",
    "admin",
    "cloudfunctions"
  ]
}
