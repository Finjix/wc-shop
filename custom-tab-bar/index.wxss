.custom-tab-bar {
  --td-tab-bar-color: #111111;
  --td-tab-bar-active-color: #F5CE2B;
  --td-tab-bar-height: 96rpx;
  overflow: visible;
}

.custom-tab-bar-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.custom-tab-bar-wrapper .text {
  font-family: 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.distribution-rebate-circle {
  display: flex;
  width: 116rpx;
  height: 116rpx;
  margin-top: -42rpx;
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  background: #F5CE2B;
  color: #8A6800;
  box-shadow: 0 4rpx 14rpx rgba(138, 104, 0, 0.22);
  font-family: 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 30rpx;
  position: relative;
  z-index: 2;
  transform-origin: center center;
  animation: distribution-rebate-pulse 1.8s ease-in-out infinite;
}

.distribution-rebate-title {
  white-space: nowrap;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 34rpx;
}

@keyframes distribution-rebate-pulse {
  0%,
  100% {
    transform: scale(1);
    box-shadow: 0 4rpx 14rpx rgba(138, 104, 0, 0.22);
  }

  50% {
    transform: scale(1.08);
    box-shadow: 0 8rpx 20rpx rgba(138, 104, 0, 0.3);
  }
}
