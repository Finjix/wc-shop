.filter-wrap {
  width: 100%;
  height: 88rpx;
  display: flex;
  justify-content: space-between;
  position: relative;
  background: #fff;
}

.filter-right-content {
  height: 100%;
  flex-basis: 100rpx;
  text-align: center;
  line-height: 88rpx;
}

.filter-left-content {
  height: 100%;
  display: flex;
  flex-grow: 2;
  flex-flow: row nowrap;
  justify-content: space-between;
}

.filter-left-content .filter-item {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 400;
  color: rgba(51, 51, 51, 1);
}

.filter-left-content .filter-item .filter-price {
  width: 16rpx;
  height: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 6rpx;
  justify-content: center;
}

.filter-left-content .filter-item .filter-price-arrow {
  width: 0;
  height: 0;
  opacity: 0.45;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
}

.filter-left-content .filter-item .filter-price-arrow-up {
  margin-bottom: 2rpx;
  border-bottom: 8rpx solid #999;
}

.filter-left-content .filter-item .filter-price-arrow-down {
  border-top: 8rpx solid #999;
}

.filter-left-content .filter-item .filter-price-arrow-up.filter-price-arrow-active {
  border-bottom-color: #695941;
  opacity: 1;
}

.filter-left-content .filter-item .filter-price-arrow-down.filter-price-arrow-active {
  border-top-color: #695941;
  opacity: 1;
}

.filter-left-content .filter-item .wr-filter {
  margin-left: 8rpx;
}

.filter-left-content .filter-active-item {
  color: #695941;
}
