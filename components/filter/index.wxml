<!-- 过滤组件 -->
<view class="wr-class filter-wrap">
	<view class="filter-left-content">
		<block wx:if="{{showMoreSorts}}">
			<view
			  class="filter-item {{overall === 1 ? 'filter-active-item' : ''}}"
			  style="color: {{overall === 1 ? color : ''}}"
			  bindtap="onOverallAction"
			>
				综合
			</view>
			<view
			  class="filter-item {{sortType === 'sales' ? 'filter-active-item' : ''}}"
			  style="color: {{sortType === 'sales' ? color : ''}}"
			  bindtap="handleSortType"
			  data-sort-type="sales"
			>
				销量
			</view>
			<view
			  class="filter-item {{sortType === 'new' ? 'filter-active-item' : ''}}"
			  style="color: {{sortType === 'new' ? color : ''}}"
			  bindtap="handleSortType"
			  data-sort-type="new"
			>
				上新
			</view>
			<view class="filter-item" bind:tap="handlePriseSort">
				<text style="color: {{sorts !== '' ? color : '' }}">价格</text>
				<view class="filter-price">
					<view class="filter-price-arrow filter-price-arrow-up {{sorts === 'asc' ? 'filter-price-arrow-active' : ''}}"></view>
					<view class="filter-price-arrow filter-price-arrow-down {{sorts === 'desc' ? 'filter-price-arrow-active' : ''}}"></view>
				</view>
			</view>
		</block>
		<block wx:else>
			<view class="filter-item {{overall === 1 ? 'filter-active-item' : ''}}" bindtap="onOverallAction">
				综合
			</view>
			<view class="filter-item" bind:tap="handlePriseSort">
				<text style="color: {{sorts !== '' ? color : '' }}">价格</text>
				<view class="filter-price">
					<view class="filter-price-arrow filter-price-arrow-up {{sorts === 'asc' ? 'filter-price-arrow-active' : ''}}"></view>
					<view class="filter-price-arrow filter-price-arrow-down {{sorts === 'desc' ? 'filter-price-arrow-active' : ''}}"></view>
				</view>
			</view>
			<view class="filter-item {{prices.length ? 'filter-active-item' : ''}}" bindtap="open" data-index="5">
				筛选
				<t-icon
				  name="filter"
				  prefix="wr"
				  color="#333"
				  size="32rpx"
				/>
			</view>
		</block>
	</view>
</view>
<!-- 筛选弹框 -->
<slot name="filterPopup" />
