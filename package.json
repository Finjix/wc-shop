{
  "name": "@tencent/tdesign-miniprogram-starter-retail",
  "version": "0.2.0",
  "description": "",
  "main": "app.ts",
  "scripts": {
    "lint": "eslint --cache --ext .js,.ts,.tsx . --ignore-pattern admin/** --ignore-pattern cloudfunctions/**",
    "lint:fix": "eslint --cache --fix --ext .js,.ts,.tsx . --ignore-pattern admin/** --ignore-pattern cloudfunctions/**",
    "typecheck": "tsc --noEmit",
    "typecheck:cloud": "tsc -p cloudfunctions/tsconfig.json",
    "build:cloudfunction": "tsc -p cloudfunctions/tsconfig.json",
    "test:cloud": "tsc -p cloudfunctions/tsconfig.json && node cloudfunctions/.build/tests/run.js",
    "test:admin-upload": "node scripts/test-admin-upload.cjs",
    "test:admin-draft-images": "node scripts/test-admin-draft-images.cjs",
    "test:admin-session": "node scripts/test-admin-session.cjs",
    "test:checkout": "node scripts/test-checkout.cjs",
    "test:order-after-sales": "node scripts/test-order-after-sales.cjs",
    "test:order-receipt": "node scripts/test-order-receipt.cjs",
    "test:commerce-http": "npm run build:cloudfunction && node scripts/test-commerce-http.cjs",
    "dev:local-backend": "npm run build:cloudfunction && node scripts/local-backend.js",
    "build:admin": "npm --prefix admin run build",
    "package:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-deploy-bundles.ps1",
    "check": "node config/eslintCheck.js && npm run typecheck && npm run typecheck:cloud && npm run build:admin",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "test:loading": "node scripts/test-loading.cjs",
    "test:subpackage-dependencies": "node scripts/test-subpackage-dependencies.cjs",
    "build:subpackage-ui": "node scripts/build-subpackage-ui.cjs",
    "build:image-codec": "node scripts/build-image-codec.cjs",
    "test:user-images": "node scripts/test-user-images.cjs",
    "test:cloud-dependencies": "tsc -p cloudfunctions/tsconfig.json && node scripts/test-cloud-dependencies.cjs"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "tdesign-miniprogram": "1.9.5",
    "tslib": "^1.11.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "conventional-changelog-cli": "^2.2.2",
    "eslint": "^8.57.1",
    "miniprogram-api-typings": "^3.12.0",
    "typescript": "^5.9.3"
  }
}
