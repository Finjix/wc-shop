{
  "name": "@tencent/tdesign-miniprogram-starter-retail",
  "version": "0.2.0",
  "description": "",
  "main": "miniprogram/app.ts",
  "scripts": {
    "lint": "eslint --cache --cache-location ../.wc-shop-local/cache/eslint --ext .js,.ts,.tsx . --ignore-pattern admin/** --ignore-pattern cloudfunctions/**",
    "lint:fix": "eslint --cache --cache-location ../.wc-shop-local/cache/eslint --fix --ext .js,.ts,.tsx . --ignore-pattern admin/** --ignore-pattern cloudfunctions/**",
    "typecheck": "tsc --noEmit",
    "typecheck:cloud": "tsc -p cloudfunctions/tsconfig.json",
    "build:cloudfunction": "tsc -p cloudfunctions/tsconfig.json",
    "test:cloud": "tsc -p cloudfunctions/tsconfig.json && node cloudfunctions/.build/tests/run.js",
    "test:admin-upload": "node scripts/test-admin-upload.cjs",
    "test:admin-draft-images": "node scripts/test-admin-draft-images.cjs",
    "test:admin-lightbox": "node scripts/test-admin-lightbox.cjs",
    "test:admin-confirm": "node scripts/test-admin-confirm.cjs",
    "test:browser-leave-warning": "node scripts/test-browser-leave-warning.cjs",
    "test:checkout": "node scripts/test-checkout.cjs",
    "test:shoe-specs": "node scripts/test-shoe-specs.cjs",
    "test:admin-variants": "node scripts/test-admin-variants.cjs",
    "test:product-covers": "node scripts/test-product-covers.cjs",
    "test:product-names": "node scripts/test-product-names.cjs",
    "test:wechat-checkout": "node scripts/test-wechat-checkout.cjs",
    "test:local-addresses": "node scripts/test-local-addresses.cjs",
    "test:order-after-sales": "node scripts/test-order-after-sales.cjs",
    "test:logistics": "node scripts/test-logistics-navigation.cjs",
    "test:order-receipt": "node scripts/test-order-receipt.cjs",
    "test:order-comment": "node scripts/test-order-comment.cjs",
    "test:commerce-http": "npm run build:cloudfunction && node scripts/test-commerce-http.cjs",
    "dev:local-backend": "npm run build:cloudfunction && node scripts/local-backend.js",
    "build:admin": "npm --prefix admin run build",
    "package:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-deploy-bundles.ps1",
    "check": "npm run lint && npm run typecheck && npm run typecheck:cloud && npm run build:admin",
    "test:loading": "node scripts/test-loading.cjs",
    "test:comments": "node scripts/test-comments.cjs",
    "test:subpackage-dependencies": "node scripts/test-subpackage-dependencies.cjs",
    "test:package-loading": "node scripts/test-package-loading.cjs",
    "build:subpackage-ui": "node scripts/build-subpackage-ui.cjs",
    "build:image-codec": "node scripts/build-image-codec.cjs",
    "test:user-images": "node scripts/test-user-images.cjs",
    "test:cloud-dependencies": "tsc -p cloudfunctions/tsconfig.json && node scripts/test-cloud-dependencies.cjs",
    "test:temp-file-urls": "node scripts/test-temp-file-urls.cjs",
    "test:admin-public": "node scripts/test-admin-public.cjs",
    "build:home-promos": "node scripts/build-home-promos.cjs && node scripts/build-promo-frames.cjs",
    "build:promo-frames": "node scripts/build-promo-frames.cjs",
    "test:promo-frames": "node scripts/test-promo-frames.cjs",
    "test:home-promos": "node scripts/test-home-promos.cjs",
    "build:home-mascots": "node scripts/build-home-mascots.cjs",
    "test:home-showcase": "node scripts/test-home-showcase.cjs",
    "test:sharing": "node scripts/test-sharing.cjs"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "tdesign-miniprogram": "1.9.5",
    "tslib": "^1.11.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "miniprogram-api-typings": "^3.12.0",
    "typescript": "^5.9.3"
  }
}
