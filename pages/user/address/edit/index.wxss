page {
  background-color: #FCF8EE;
}
page .divider-line {
  width: 100%;
  height: 20rpx;
  background-color: #FCF8EE;
}
.address-detail {
  font-size: 30rpx;
}

.form-cell .t-cell__title {
  width: 144rpx;
  padding-right: 32rpx;
  flex: none !important;
}

.textarea__wrapper {
  width: 100%;
}

.textarea__wrapper .t-textarea {
  padding: 0 !important;
}

.submit {
  box-sizing: border-box;
  padding: 64rpx 30rpx 88rpx 30rpx;
}
.submit .btn-submit-address {
  --td-button-font-weight: 700;
  --td-button-default-color: #fff;
  --td-button-default-bg-color: #695941;
  --td-button-default-border-color: #695941;
  --td-button-default-active-bg-color: #695941;
  --td-button-default-active-border-color: #695941;
  background: #695941 !important;
  color: #fff !important;
  font-weight: 700;
}

.form-address .form-content {
  --td-input-vertical-padding: 0;
}
