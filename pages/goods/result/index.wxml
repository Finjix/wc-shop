<view class="goods-list-page">
  <view class="goods-list-header">
      <t-navbar
        t-class-title="goods-list-navbar__title"
        title=""
        leftArrow
        fixed="{{false}}"
        background="#fff"
      />
      <view
        class="goods-list-navbar-search"
        style="top: {{searchTop}}px; left: {{searchLeft}}px; width: {{searchWidth}}px;"
      >
        <t-search
          t-class="goods-list-navbar-search__control"
          t-class-input-container="goods-list-navbar-search__input-container"
          t-class-left="goods-list-navbar-search__left-icon"
          t-class-input="goods-list-navbar-search__input"
          value="{{searchInput}}"
          leftIcon=""
          clearable="{{false}}"
          placeholder=""
          bind:submit="handleSubmit"
        >
          <t-icon slot="left-icon" prefix="wr" name="search" size="40rpx" color="#bbb" />
        </t-search>
      </view>
      <view class="goods-list-toolbar">
    <filter
      wr-class="filter-container"
      bind:change="handleFilterChange"
      layout="{{layout}}"
      sorts="{{sorts}}"
      overall="{{overall}}"
      sortType="{{sortType}}"
      showMoreSorts="{{true}}"
      color="#695941"
      bind:showFilterPopup="showFilterPopup"
    >
      <filter-popup
        show="{{show}}"
        slot="filterPopup"
        bind:showFilterPopupClose="showFilterPopupClose"
        bind:reset="reset"
        bind:confirm="confirm"
      >
        <view class="price-container" slot="filterSlot">
          <view class="price-between">价格区间</view>
          <view class="price-ipts-wrap">
            <t-input
              align="center"
              type="number"
              t-class="price-ipt"
              placeholder="最低价"
              value="{{minVal}}"
              bindchange="onMinValAction"
            />
            <view class="price-divided">-</view>
            <t-input
              align="center"
              type="number"
              t-class="price-ipt"
              placeholder="最高价"
              value="{{maxVal}}"
              bindchange="onMaxValAction"
            />
          </view>
        </view>
      </filter-popup>
    </filter>
      </view>
  </view>
  <scroll-view
    class="goods-list-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{true}}"
    bounces="{{false}}"
    enable-back-to-top="{{true}}"
    bindscrolltolower="onReachBottom"
  >
    <view class="goods-list-container">
      <view class="empty-wrap" wx:if="{{goodsList.length === 0 && hasLoaded}}">
      <t-empty t-class="empty-tips" size="240rpx" description="{{emptyInfo.tip || '暂无相关商品'}}" />
    </view>
    <view class="category-goods-list" wx:if="{{goodsList.length}}">
      <goods-list
        wr-class="wr-goods-list"
        layout="horizontal"
        goodsList="{{goodsList}}"
        showAddCart="{{false}}"
        bind:click="gotoGoodsDetail"
      />
    </view>
    <load-more
      wx:if="{{loadMoreStatus === 1}}"
      status="{{loadMoreStatus}}"
      no-more-text="没有更多了"
      bind:retry="onRetryLoad"
    />
    </view>
  </scroll-view>
</view>
<t-toast id="t-toast" />
