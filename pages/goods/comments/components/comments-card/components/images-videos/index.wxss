.resource-item-single {
  width: 360rpx;
  height: 360rpx;
  border-radius: 8rpx;
}

.resource-item-double {
  width: 334rpx;
  height: 334rpx;
  border-radius: 8rpx;
}

.resource-item-multiple {
  width: 218rpx;
  height: 218rpx;
  border-radius: 8rpx;
}

.resource-container-single {
  padding-left: 0;
  padding-top: 0;
}

.resource-container-double {
  padding-left: 18rpx;
  padding-top: 18rpx;
}

.resource-container-multiple {
  padding-left: 16rpx;
  padding-top: 16rpx;
}

.container-single {
  margin-left: 0;
}

.container-double {
  margin-left: -18rpx;
  margin-top: -18rpx;
}

.container-multiple {
  margin-left: -16rpx;
  margin-top: -16rpx;
}

.resource-unavailable {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  color: #999;
  font-size: 24rpx;
}

.resource-container {
  display: flex;
}

.images-videos-container {
  display: flex;
  flex-wrap: wrap;
}

.container-compact {
  display: grid;
  width: 100%;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin: 0;
}

.container-compact.container-single {
  grid-template-columns: minmax(0, 1fr);
  max-width: 400rpx;
}

.container-compact.container-double {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.container-compact .resource-container {
  display: block;
  position: relative;
  padding: 0;
  min-width: 0;
  overflow: hidden;
  border-radius: 14rpx;
}

.container-compact .resource-container::before {
  content: '';
  display: block;
  padding-top: 100%;
}

.container-compact .resource-item-single,
.container-compact .resource-item-double,
.container-compact .resource-item-multiple {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}
