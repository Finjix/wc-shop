<view class="home-page-header home-page-header--fixed" style="top: {{searchTop}}px; left: {{searchLeft}}px; width: {{searchWidth}}px;">
  <view class="search" bind:tap="focusSearch">
    <t-search
      t-class="home-search"
      t-class-input-container="search-only"
      t-class-input="search-input"
      value="{{searchValue}}"
      leftIcon=""
      clearable="{{false}}"
      placeholder=""
      focus="{{searchFocus}}"
      bind:focus="handleSearchFocus"
      bind:blur="handleSearchBlur"
      bind:change="handleSearchChange"
      bind:submit="handleSearchSubmit"
    >
      <view slot="left-icon" class="search-icon">
        <t-icon prefix="wr" name="search" size="40rpx" color="#9d8f96" />
      </view>
    </t-search>
    <view wx:if="{{!searchFocus && !searchValue}}" class="search-marquee">
      <view class="search-marquee__track">
        <text class="search-marquee__item">邀请好友，享现金返利！</text>
        <text class="search-marquee__item">邀请好友，享现金返利！</text>
        <text class="search-marquee__item">邀请好友，享现金返利！</text>
        <text class="search-marquee__item">邀请好友，享现金返利！</text>
      </view>
    </view>
  </view>
</view>

<scroll-view class="home-scroll" scroll-y enhanced show-scrollbar="{{true}}" bounces="{{false}}">
  <view class="home-scroll-content">
    <view class="swiper-wrap">
      <t-swiper
        wx:if="{{imgSrcs.length > 0}}"
        t-class="home-swiper"
        t-class-image="home-swiper__image"
        height="1333.333rpx"
        current="{{current}}"
        autoplay="{{autoplay}}"
        duration="{{duration}}"
        interval="{{interval}}"
        navigation="{{false}}"
        imageProps="{{swiperImageProps}}"
        list="{{imgSrcs}}"
        bind:click="navToGoodsDetail"
      />
    </view>

    <view class="home-safety-banner">
      <text>未满18禁用 | 保密发货 | 官方正品</text>
    </view>

    <view class="home-featured-title">
      <text class="home-featured-title__en">Heartfelt Recommendations</text>
      <text class="home-featured-title__zh">倾心推荐</text>
    </view>
    <view class="home-featured-swiper">
      <t-swiper
        wx:if="{{dynamicGoodsSrcs.length > 0}}"
        t-class="home-featured-swiper__host"
        t-class-image="home-featured-swiper__image"
        t-class-prev-image="home-featured-swiper__side-image"
        t-class-next-image="home-featured-swiper__side-image"
        height="1066.667rpx"
        current="{{dynamicCurrent}}"
        autoplay="{{true}}"
        duration="500"
        interval="3000"
        navigation="{{false}}"
        previous-margin="75rpx"
        next-margin="75rpx"
        imageProps="{{featuredSwiperImageProps}}"
        list="{{dynamicGoodsSrcs}}"
        bind:click="navToDynamicGoodsDetail"
      />
    </view>

    <view style="text-align: center; color: #b9b9b9" wx:if="{{pageLoading}}">
      <t-loading theme="circular" size="40rpx" text="加载中..." inherit-color />
    </view>
    <view class="home-product-title home-featured-title">
      <text class="home-featured-title__en">More Gifts</text>
      <text class="home-featured-title__zh">更多献礼</text>
    </view>
    <view wx:if="{{hotGoods.length}}" class="home-product-showcase">
      <view class="home-product-showcase__hero" bind:tap="navToHotGoodsHeroDetail">
        <image
          class="home-product-showcase__hero-image"
          src="{{productHeroSrc}}"
          mode="aspectFill"
          lazy-load
        />
      </view>
      <view class="home-product-showcase__grid">
        <view
          wx:for="{{hotShowcaseGoods}}"
          wx:key="index"
          class="home-product-showcase__card"
          data-spu-id="{{item.spuId}}"
          bind:tap="navToHotGoodsDetail"
        >
          <image
            class="home-product-showcase__image"
            src="{{item.thumb}}"
            mode="aspectFill"
            lazy-load
          />
        </view>
      </view>
    </view>

    <view wx:if="{{newGoods.length}}" class="new-sale-section">
      <view class="hot-sale__pink-frame new-sale__frame">
        <view class="new-sale__layout">
          <view
            wx:for="{{newGoods}}"
            wx:key="index"
            class="new-product-card"
            data-spu-id="{{item.spuId}}"
            bind:tap="navToHotGoodsDetail"
          >
            <view class="new-product-card__image-wrap">
              <image
                class="new-product-card__image"
                src="{{item.thumb}}"
                mode="aspectFill"
                lazy-load
              />
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{domesticGoods.length}}" class="hot-sale-section">
      <view class="hot-sale__pink-frame">
        <view class="hot-sale__grid">
          <view
            wx:for="{{domesticGoods}}"
            wx:key="index"
            class="hot-product-card"
            data-spu-id="{{item.spuId}}"
            bind:tap="navToHotGoodsDetail"
          >
            <view class="hot-product-card__image-wrap">
              <image
                class="hot-product-card__image"
                src="{{item.thumb}}"
                mode="aspectFill"
                lazy-load
              />
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{lubricantGoods.length}}" class="new-sale-section">
      <view class="hot-sale__pink-frame new-sale__frame">
        <view class="new-sale__layout">
          <view
            wx:for="{{lubricantGoods}}"
            wx:key="index"
            class="new-product-card"
            data-spu-id="{{item.spuId}}"
            bind:tap="navToHotGoodsDetail"
          >
            <view class="new-product-card__image-wrap">
              <image
                class="new-product-card__image"
                src="{{item.thumb}}"
                mode="aspectFill"
                lazy-load
              />
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{toyGoods.length}}" class="hot-sale-section">
      <view class="hot-sale__pink-frame">
        <view class="hot-sale__grid">
          <view
            wx:for="{{toyGoods}}"
            wx:key="index"
            class="hot-product-card"
            data-spu-id="{{item.spuId}}"
            bind:tap="navToHotGoodsDetail"
          >
            <view class="hot-product-card__image-wrap">
              <image
                class="hot-product-card__image"
                src="{{item.thumb}}"
                mode="aspectFill"
                lazy-load
              />
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{lastingGoods.length}}" class="new-sale-section">
      <view class="hot-sale__pink-frame new-sale__frame">
        <view class="new-sale__layout">
          <view
            wx:for="{{lastingGoods}}"
            wx:key="index"
            class="new-product-card"
            data-spu-id="{{item.spuId}}"
            bind:tap="navToHotGoodsDetail"
          >
            <view class="new-product-card__image-wrap">
              <image
                class="new-product-card__image"
                src="{{item.thumb}}"
                mode="aspectFill"
                lazy-load
              />
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
