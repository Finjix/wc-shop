<scroll-view class="home-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="home-scroll-content">
    <view style="text-align: center; color: #b9b9b9" wx:if="{{pageLoading}}">
      <t-loading theme="circular" size="40rpx" text="加载中..." inherit-color />
    </view>
    <view class="home-page-header">
      <view
        class="home-custom-nav"
        style="height: {{customNavHeight}}px; padding-top: {{statusBarHeight}}px;"
      >
        <view class="home-custom-nav__content" style="height: {{navBarHeight}}px;">番薯小店</view>
      </view>
      <view class="search" bind:tap="navToSearchPage">
        <t-search
          t-class-input="t-search__input"
          t-class-input-container="t-search__input-container"
          placeholder="官方正品 保密发货 售后无忧"
          leftIcon=""
          disabled
        >
          <view slot="left-icon" class="search-leading">
            <t-icon prefix="wr" name="search" size="40rpx" color="#9d8f96" />
          </view>
        </t-search>
      </view>
    </view>

    <view class="broadcast-bar">
      <view class="broadcast-icon">
        <t-icon name="sound" size="30rpx" color="#F77299" />
      </view>
      <view class="broadcast-viewport">
        <view class="broadcast-track">
          <text class="broadcast-message">邀请好友，享现金返利！</text>
          <text class="broadcast-message">邀请好友，享现金返利！</text>
          <text class="broadcast-message">邀请好友，享现金返利！</text>
          <text class="broadcast-message">邀请好友，享现金返利！</text>
        </view>
      </view>
    </view>

  <view class="swiper-wrap">
    <t-swiper
      wx:if="{{imgSrcs.length > 0}}"
        t-class="home-swiper"
        t-class-image="home-swiper__image"
      height="1000rpx"
        current="{{current}}"
        autoplay="{{autoplay}}"
        duration="{{duration}}"
        interval="{{interval}}"
        navigation="{{navigation}}"
        imageProps="{{swiperImageProps}}"
        list="{{imgSrcs}}"
      bind:click="navToGoodsDetail"
    />
  </view>

  <view class="shop-benefits-banner">
    <image
      class="shop-benefits-banner__image"
      src="../../assets/shop-benefits-banner.jpg"
      mode="widthFix"
      lazy-load
      show-menu-by-longpress="{{true}}"
    />
  </view>

  <view class="age-warning">——未满18周岁禁止使用——</view>

  <view wx:if="{{hotGoods.length}}" class="hot-sale-section">
      <view class="hot-sale__title">热销套装榜 明星单品</view>
      <view class="hot-sale__pink-frame">
        <view class="hot-sale__pattern" />
        <view class="hot-sale__grid">
          <view
            wx:for="{{hotGoods}}"
            wx:key="spuId"
            class="hot-product-card"
            data-spu-id="{{item.spuId}}"
            bind:tap="navToHotGoodsDetail"
          >
            <view class="hot-product-card__image-wrap">
              <image
                class="hot-product-card__image"
                src="{{item.thumb}}"
                mode="aspectFill"
                lazy-load
              />
            </view>
            <view class="hot-product-card__price-bar">
              <view class="hot-product-card__price">
                <text class="hot-product-card__price-label">到手</text>
                <price
                  wr-class="hot-product-card__price-number"
                  price="{{item.price}}"
                />
                <text class="hot-product-card__price-suffix">起</text>
              </view>
              <view class="hot-product-card__price-action">
                <t-icon name="chevron-right" size="26rpx" color="#fff" />
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
