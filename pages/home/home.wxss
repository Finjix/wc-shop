page {
  box-sizing: border-box;
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  background-color: #FCF8EE;
}

.home-scroll {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
}

.home-scroll-content {
  position: relative;
  background: #FCF8EE;
  padding-bottom: calc(env(safe-area-inset-bottom) + 80rpx + 64rpx);
}

.swiper-wrap {
  width: 100%;
  margin: 0;
  background: #FCF8EE;
}

.swiper-wrap .home-swiper,
.swiper-wrap .t-swiper-host {
  width: 100%;
  border-radius: 0 !important;
  overflow: hidden;
}

.swiper-wrap .home-swiper__image,
.swiper-wrap .t-swiper__image {
  width: 100% !important;
  height: 1333.333rpx !important;
  background: #FCF8EE;
  border-radius: 0 !important;
}

.home-safety-banner {
  display: flex;
  width: 100%;
  height: 72rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  background-color: #FCF8EE !important;
  color: #695941;
  font-size: 28rpx;
  line-height: 1;
  letter-spacing: 1rpx;
}

.home-promo-cards {
  display: flex;
  gap: 4rpx;
  padding: 0;
  background: #FCF8EE;
}

.home-promo-card {
  display: flex;
  width: calc((100% - 4rpx) / 2);
  height: calc((100vw - 4rpx) / 2);
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
}

.home-promo-card__image {
  display: block;
  width: 100%;
  height: 100%;
}

.home-featured-title {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0;
  background: #FCF8EE;
  color: #695941;
}

.home-featured-title__zh {
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 2rpx;
}

.home-recommendation-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 24rpx 64rpx;
  background: #FCF8EE;
}

.home-recommendation-card {
  width: calc((100% - 16rpx) / 2);
  height: calc((100vw - 64rpx) / 2);
  overflow: hidden;
  border-radius: 24rpx;
}

.home-recommendation-card__image {
  display: block;
  width: 100%;
  height: 100%;
}

.hot-sale-section {
  width: auto;
  margin: 0;
  overflow: hidden;
  background: #FCF8EE;
  font-family: 'Microsoft YaHei', '微软雅黑', 'MicrosoftJhengHei', '华文细黑', Helvetica, Arial, sans-serif;
}

.hot-sale__pink-frame {
  margin: 0 24rpx;
  padding: 0;
  background: transparent;
}

.hot-sale__grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.hot-product-card {
  display: flex;
  width: calc((100% - 24rpx) / 2);
  height: calc((100vw - 72rpx) / 2);
  flex-direction: column;
  margin-bottom: 16rpx;
  overflow: hidden;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.hot-product-card__image-wrap {
  display: block;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #fff;
  border-radius: 16rpx;
}

.hot-product-card__image {
  display: block;
  width: 100%;
  height: 100%;
}

.new-sale-section {
  width: auto;
  margin: 0;
  overflow: hidden;
  background: #FCF8EE;
  font-family: 'Microsoft YaHei', '微软雅黑', 'MicrosoftJhengHei', '华文细黑', Helvetica, Arial, sans-serif;
}

.new-sale__layout {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.new-product-card {
  display: flex;
  width: calc((100% - 24rpx) / 2);
  height: calc((100vw - 72rpx) / 2);
  overflow: hidden;
  flex-direction: column;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.new-product-card__image-wrap {
  display: block;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #fff;
  border-radius: 16rpx;
}

.new-product-card__image {
  display: block;
  width: 100%;
  height: 100%;
}
