page {
  box-sizing: border-box;
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0;
  background-color: #FCF8EE;
}

.home-scroll {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
}

.home-scroll-content {
  position: relative;
  background: #FCF8EE;
  padding-bottom: calc(env(safe-area-inset-bottom) + 80rpx + 64rpx);
}

.home-page-header {
  background: #fff;
  padding-bottom: 32rpx;
}

.home-page-header .search {
  margin-top: -64rpx;
}

.home-page-header {
  display: block;
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.home-page-header--fixed .search {
  margin-top: 0;
}

.home-page-header--fixed {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 20;
  width: auto;
  box-sizing: border-box;
  padding-top: 0;
  padding-bottom: 0;
  padding-left: 0;
  padding-right: 0;
  background: transparent;
}

.home-page-header .search-only {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  border-radius: 32rpx;
  height: 64rpx;
  background-color: rgba(255, 255, 255, 0.5) !important;
  border: none !important;
  padding: 0 24rpx !important;
}

.search-icon {
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.search-divider {
  flex: 0 0 1rpx;
  width: 1rpx;
  height: 32rpx;
  margin-right: 0;
  background-color: rgba(93, 93, 93, 0.28);
}

.search-marquee {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
}

.search-marquee__track {
  display: flex;
  width: max-content;
  animation: search-marquee 8s linear infinite;
  will-change: transform;
}

.search-marquee__item {
  flex: 0 0 auto;
  padding-right: 64rpx;
  color: #5d5d5d;
  font-size: 26rpx;
  line-height: 40rpx;
  white-space: nowrap;
}

@keyframes search-marquee {
  from {
    transform: translate3d(0, 0, 0);
  }
  to {
    transform: translate3d(-25%, 0, 0);
  }
}

.swiper-wrap {
  width: 100%;
  margin: 0;
  background: #FCF8EE;
}

.swiper-wrap .home-swiper,
.swiper-wrap .t-swiper-host {
  width: 100%;
  border-radius: 0 !important;
  overflow: hidden;
}

.swiper-wrap .home-swiper__image,
.swiper-wrap .t-swiper__image {
  width: 100% !important;
  height: 1333.333rpx !important;
  background: #FCF8EE;
  border-radius: 0 !important;
}

.home-safety-banner {
  display: flex;
  width: 100%;
  height: 72rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  background-color: #FCF8EE !important;
  color: #695941;
  font-size: 28rpx;
  line-height: 1;
  letter-spacing: 1rpx;
}

.home-placeholder-cards {
  display: flex;
  gap: 4rpx;
  padding: 0;
  background: #FCF8EE;
}

.home-placeholder-card {
  display: flex;
  width: calc((100% - 4rpx) / 2);
  height: calc((100vw - 4rpx) / 2);
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  background: #D9D9D9;
  color: #777;
  font-size: 32rpx;
}

.home-placeholder-card__image {
  display: block;
  width: 100%;
  height: 100%;
}

.home-featured-title {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 0;
  background: #FCF8EE;
  color: #695941;
}

.home-featured-title__en {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 32rpx;
  font-style: italic;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

.home-featured-title__zh {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 2rpx;
}

.home-featured-swiper {
  width: 100%;
  padding: 0;
  background: #FCF8EE;
}

.home-featured-swiper .home-featured-swiper__host,
.home-featured-swiper .t-swiper-host {
  border-radius: 48rpx !important;
  overflow: hidden !important;
}

.home-featured-swiper .t-swiper__item {
  border-radius: 48rpx !important;
  overflow: hidden !important;
}

.home-featured-swiper .home-featured-swiper__image,
.home-featured-swiper .home-featured-swiper__image-host,
.home-featured-swiper .home-featured-swiper__side-image,
.home-featured-swiper .t-swiper__image-host,
.home-featured-swiper .t-swiper__image {
  width: 100% !important;
  height: 1066.667rpx !important;
  border-radius: 48rpx !important;
  overflow: hidden !important;
  --td-image-round-radius: 48rpx;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.16);
  transition: transform 0.35s ease, opacity 0.35s ease, box-shadow 0.35s ease;
  transform: scale(1);
}

.home-featured-swiper .home-featured-swiper__side-image {
  opacity: 0.72;
  transform: scale(0.84);
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.1);
}

.home-product-showcase {
  margin: 0 24rpx;
  background: #FCF8EE;
}

.home-product-showcase__hero {
  width: 100%;
  height: calc((100vw - 48rpx) * 9 / 16);
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: #D9D9D9;
  border-radius: 24rpx;
}

.home-product-showcase__hero-image {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

.home-product-showcase--placeholder .home-product-showcase__hero,
.home-product-showcase--placeholder .home-product-showcase__card {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #D9D9D9;
  color: #777;
  font-size: 32rpx;
}

.home-product-showcase__grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.home-product-showcase__card {
  position: relative;
  width: calc((100% - 16rpx) / 2);
  height: calc((100vw - 64rpx) * 9 / 32);
  aspect-ratio: 16 / 9;
  box-sizing: border-box;
  overflow: hidden;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.home-product-showcase__image {
  display: block;
  width: 100%;
  height: 100%;
}

.hot-sale-section {
  width: auto;
  margin: 0;
  overflow: hidden;
  background: #FCF8EE;
  font-family: 'Microsoft YaHei', '微软雅黑', 'MicrosoftJhengHei', '华文细黑', Helvetica, Arial, sans-serif;
}

.hot-sale__pink-frame {
  margin: 0 24rpx;
  padding: 0;
  background: transparent;
}

.hot-sale__grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.hot-product-card {
  display: flex;
  width: calc((100% - 24rpx) / 2);
  height: calc((100vw - 72rpx) / 2);
  flex-direction: column;
  margin-bottom: 16rpx;
  overflow: hidden;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.hot-product-card__image-wrap {
  display: block;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #fff;
  border-radius: 16rpx;
}

.hot-product-card__image {
  display: block;
  width: 100%;
  height: 100%;
}

.new-sale-section {
  width: auto;
  margin: 0;
  overflow: hidden;
  background: #FCF8EE;
  font-family: 'Microsoft YaHei', '微软雅黑', 'MicrosoftJhengHei', '华文细黑', Helvetica, Arial, sans-serif;
}

.new-sale__layout {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.new-product-card {
  display: flex;
  width: calc((100% - 24rpx) / 2);
  height: calc((100vw - 72rpx) / 2);
  overflow: hidden;
  flex-direction: column;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.new-product-card__image-wrap {
  display: block;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #fff;
  border-radius: 16rpx;
}

.new-product-card__image {
  display: block;
  width: 100%;
  height: 100%;
}
