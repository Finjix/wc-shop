.address-card {
  background: #fff;
  margin: 0rpx 0rpx 24rpx;
}
.address-card .wr-cell__title {
  color: #999;
  margin-left: 6rpx;
}
.address-card .order-address {
  display: flex;
  width: 100%;
}
.address-card .order-address .address-content {
  flex: 1;
}
.order-address .address__right {
  align-self: center;
}
.address-card .order-address .title {
  display: flex;
  align-items: center;
  height: 40rpx;
  font-size: 28rpx;
  font-weight: normal;
  color: #999999;
  line-height: 40rpx;
}
.address-card .order-address .detail {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  line-height: 48rpx;
  margin: 8rpx 0;
}
.address-card .order-address .info {
  height: 40rpx;
  font-size: 28rpx;
  font-weight: normal;
  color: #333333;
  line-height: 40rpx;
}
.address-card .top-line {
  width: 100%;
  height: 2rpx;
  background-color: #eeeeee;
  background-image: none;
  display: block;
}
