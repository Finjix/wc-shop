.order-sure {
  box-sizing: border-box;
  background: #fff;
  padding: 24rpx 0 calc(env(safe-area-inset-bottom) + 136rpx);
  min-height: 100vh;
}

.order-sure .wx-pay-cover {
  position: fixed;
  left: 0;
  bottom: 0;
  right: 0;
  z-index: 10;
  background: #fff;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.order-sure .wx-pay-cover .wx-pay {
  width: 100%;
  height: 100rpx;
  box-sizing: border-box;
  padding: 0rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.order-sure .wx-pay-cover .wx-pay .price {
  color: #000000;
  font-weight: bold;
  font-size: 63rpx;
  line-height: 88rpx;
}

.order-sure .wx-pay-cover .wx-pay .submit-btn {
  height: 80rpx;
  width: 240rpx;
  border-radius: 40rpx;
  background-color: var(--app-theme-color, #695941);
  color: #fff;
  line-height: 80rpx;
  font-weight: bold;
  font-size: 28rpx;
  text-align: center;
}
.order-wrapper .goods-wrapper {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 32rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  font-size: 24rpx;
  line-height: 32rpx;
  color: #999999;
  background-color: #ffffff;
}
.goods-wrapper .goods-image {
  width: 176rpx;
  height: 176rpx;
  border-radius: 8rpx;
  overflow: hidden;
  margin-right: 16rpx;
}
.goods-wrapper .goods-content {
  flex: 1;
}

.goods-wrapper .goods-content .goods-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 28rpx;
  line-height: 40rpx;
  margin-bottom: 12rpx;
  color: #333333;
  margin-right: 16rpx;
}

.goods-wrapper .goods-right {
  min-width: 128rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.goods-right .goods-price {
  color: #000000;
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.goods-right .goods-num {
  text-align: right;
}
