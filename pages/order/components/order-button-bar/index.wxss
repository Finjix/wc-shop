:host {
  width: 100%;
}
.btn-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 72rpx;
  line-height: 1;
}
.btn-bar .order-pay-amount {
  display: flex;
  align-items: baseline;
  color: #333333;
  font-size: 28rpx;
  line-height: 40rpx;
}
.btn-bar .order-pay-amount__label {
  margin-right: 8rpx;
}
.btn-bar .order-pay-amount__price {
  color: #000000;
  font-size: 36rpx;
  font-weight: bold;
}

.btn-bar .order-btn {
  line-height: 1;
  /* border-radius: unset; */
  /* min-width: 160rpx; */
}

.btn-bar .right {
  display: flex;
  align-items: center;
  margin-left: auto;
}
.btn-bar .t-button {
  width: 160rpx;
  font-weight: 400;
  margin-left: 24rpx;
}
.btn-bar .t-button--max {
  width: 176rpx;
  margin-left: 24rpx;

  --td-button-extra-small-height: 72rpx;
}

.btn-bar .right .normal {
  --td-button-default-color: #333333;
  --td-button-default-border-color: #dddddd;
}

.btn-bar .right .primary {
  --td-button-default-color: #fff;
  --td-button-default-bg-color: var(--app-theme-color, #695941);
  --td-button-default-border-color: var(--app-theme-color, #695941);
  --td-button-default-active-bg-color: rgba(105, 89, 65, 0.6);
}

.t-button {
  --td-button-default-color: #000;
  --td-button-primary-text-color: #fff;
}
