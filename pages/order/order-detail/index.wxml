<t-navbar
  t-class-title="app-page-navbar-title"
  title="订单详情"
  leftArrow
  fixed="{{false}}"
  background="#fff"
/>
<t-pull-down-refresh
  id="t-pull-down-refresh"
  value="{{pullDownRefreshing}}"
  bindrefresh="onPullDownRefresh_"
  t-class-indicator="t-class-indicator"
>
  <view wx:if="{{loadError}}" style="padding: 32rpx; text-align: center;">
    <text>{{loadError}}</text>
    <button size="mini" bindtap="init">重新加载</button>
  </view>
  <!-- 页面内容 -->
  <view wx:if="{{!loadError}}" class="order-detail">
    <view class="header">
      <!-- 物流 -->
      <view
        class="order-logistics"
        wx:if="{{showLogistics && order.logisticsVO && order.logisticsVO.logisticsNo}}"
        bindtap="onDeliveryClick"
      >
        <t-icon name="deliver" size="40rpx" class="logistics-icon" prefix="wr" />
        <view class="logistics-content">
          <view>查看物流</view>
        </view>
        <t-icon class="logistics-back" name="arrow_forward" size="36rpx" prefix="wr" />
      </view>
      <view
        class="border-bottom"
        wx:if="{{showLogistics && order.logisticsVO && order.logisticsVO.logisticsNo}}"
      />
      <!-- 收货地址 -->
      <view class="order-logistics" bindtap="onEditAddressTap">
        <view class="logistics-content">
          <view>{{order.logisticsVO.receiverName + ' '}}{{order.logisticsVO.receiverPhone}}</view>
          <view class="logistics-time">{{_order.receiverAddress}}</view>
        </view>
        <view wx:if="{{addressEditable}}" class="edit-text"> 修改 </view>
      </view>
    </view>
    <!-- 店铺及商品 -->
    <order-card order="{{_order}}" use-top-right-slot hide-store-name="{{true}}">
      <view
        wx:for="{{_order.goodsList}}"
        wx:key="id"
        wx:for-item="goods"
        wx:for-index="gIndex"
      >
        <order-goods-card
          goods="{{goods}}"
          no-top-line="{{gIndex === 0}}"
          bindtap="onGoodsCardTap"
          data-index="{{gIndex}}"
        ></order-goods-card>
      </view>
    </order-card>
    <view class="pay-detail padding-inline">
      <view class="pay-item">
        <text>实付</text>
        <view class="pay-item__right">
          <price fill wr-class="order-no normal-color" price="{{order.paymentAmount || '0'}}" />
        </view>
      </view>
      <view class="pay-item">
        <text>订单编号</text>
        <view class="pay-item__right" bindtap="onOrderNumCopy">
          <text class="order-no">{{order.orderNo}}</text>
          <view class="pay-item__right__copy">复制</view>
        </view>
      </view>
      <view class="pay-item">
        <text>下单时间</text>
        <view class="pay-item__right">
          <text class="order-no normal-color">{{formatCreateTime}}</text>
        </view>
      </view>
      <button class="pay-service" wx:if="{{storeDetail && storeDetail.storeTel}}" open-type="contact">
        <t-icon name="service" size="40rpx" />
        <text decode="{{true}}">&nbsp;联系客服</text>
      </button>
    </view>
  </view>
  <view wx:if="{{_order.buttons.length > 0}}" class="bottom-bar">
    <order-button-bar order="{{_order}}" bindrefresh="onRefresh" isBtnMax />
  </view>
</t-pull-down-refresh>
<t-toast id="t-toast" />
<t-dialog id="t-dialog" />
