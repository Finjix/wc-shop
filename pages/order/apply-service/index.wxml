<scroll-view class="app-page-scroll" scroll-y enhanced show-scrollbar="{{true}}" bounces="{{false}}" refresher-enabled="{{false}}">
<t-navbar
  t-class-title="app-page-navbar-title"
  title="售后申请"
  leftArrow
  fixed="{{false}}"
  background="#fff"
/>
<view class="select-service">
  <view wx:if="{{!orderLevel}}" class="order-goods-card">
    <view wx:for="{{goodsInfoList}}" wx:for-item="goods" wx:key="skuId" class="apply-goods-summary">
      <image wx:if="{{goods.thumb}}" class="apply-goods-summary__image" src="{{goods.thumb}}" mode="aspectFill" />
      <view wx:else class="apply-goods-summary__image apply-goods-summary__image--empty">商品</view>
      <view class="apply-goods-summary__content">
        <text class="apply-goods-summary__title">{{goods.title || '商品'}}</text>
        <text wx:if="{{goods.specText}}" class="apply-goods-summary__specs">{{goods.specText}}</text>
        <view class="apply-goods-summary__meta">
          <text class="apply-goods-summary__price">¥{{goods.paidAmountText}}</text>
          <text class="apply-goods-summary__quantity">x {{goods.boughtQuantity}}</text>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{!serviceRequireType}}" class="service-choice">
    <t-cell-group>
      <t-cell
        title="申请退款（无需退货）"
        arrow
        description="没收到货，或与商家协商同意不用退货只退款"
        bindtap="onApplyOnlyRefund"
      >
        <t-icon
          slot="left-icon"
          prefix="wr"
          class="t-cell__left__icon"
          name="goods_refund"
          size="48rpx"
          color="#695941"
        />
      </t-cell>
      <t-cell wx:if="{{canApplyReturn}}" title="退货退款" description="已收到货，需要退还收到的商品" arrow bindtap="onApplyReturnGoods">
        <t-icon
          slot="left-icon"
          prefix="wr"
          class="t-cell__left__icon"
          name="goods_return"
          size="48rpx"
          color="#695941"
        />
      </t-cell>
      <t-cell wx:elif="{{returnAddressMissing}}" class="non-returnable" title="退货退款" description="商家尚未配置退货地址，暂不能申请退货退款">
        <t-icon
          slot="left-icon"
          prefix="wr"
          class="t-cell__left__icon"
          name="goods_return"
          size="48rpx"
          color="#695941"
        />
      </t-cell>
    </t-cell-group>
  </view>
  <!-- 售后表单 -->
  <view wx:else class="service-form">
    <view class="service-from-group">
      <t-cell-group>
        <t-cell title="商品收货状态" arrow note="{{serviceFrom.receiptStatus.desc}}" bind:tap="onApplyGoodsStatus" />
      </t-cell-group>
    </view>
    <view class="service-from-group">
      <t-cell-group>
        <t-cell wx:if="{{!orderLevel}}" title="退款商品数量">
          <t-stepper
            slot="note"
            theme="filled"
            min="1"
            max="{{maxApplyNum}}"
            value="{{serviceFrom.returnNum}}"
            bindchange="onChangeReturnNum"
          />
        </t-cell>
        <t-cell
          title="退款金额"
          t-class-description="refund-money__description"
          description="{{amountTip}}"
        >
          <view class="service-from-group__wrapper" slot="note">
            <text class="refund-money-price">¥{{refundAmountText}}</text>
          </view>
        </t-cell>
      </t-cell-group>
    </view>
    <view class="service-from-group__textarea">
      <text class="textarea--label">退款原因</text>
      <t-textarea
        style="height: 220rpx"
        value="{{serviceFrom.remark}}"
        t-class="textarea--content"
        maxlength="200"
        indicator
        placeholder="请输入退款原因（必填）"
        bind:change="onRemarkChange"
      />
    </view>
    <view class="service-from-group__grid">
      <t-upload
        disabled="{{processingImages || submitting}}"
        media-type="{{['image']}}"
        sizeLimit="{{10485760}}"
        files="{{serviceFrom.rightsImageUrls}}"
        bind:remove="handleRemove"
        bind:success="handleSuccess"
        bind:complete="handleComplete"
        bind:select-change="handleSelectChange"
        gridConfig="{{uploadGridConfig}}"
        max="3"
      >
        <view slot="add-content" class="upload-addcontent-slot">
          <t-icon name="add" size="60rpx" />
          <view class="upload-desc">
            <text>上传凭证</text>
            <text>（最多3张）</text>
          </view>
        </view>
      </t-upload>
    </view>
    <view class="bottom-bar">
      <t-button
        t-class="bottom-bar__btn"
        bindtap="onSubmit"
        disabled="{{submitting || processingImages}}"
        loading="{{submitting}}"
      >
        提交
      </t-button>
    </view>
  </view>
</view>
</scroll-view>
<!-- 收货状态选择 -->
<t-popup visible="{{showReceiptStatusDialog}}" placement="bottom" bindclose="onReceiptStatusDialogConfirm">
  <view class="dialog--service-status" slot="content">
    <view class="options">
      <view
        wx:for="{{receiptStatusList}}"
        wx:key="status"
        class="option"
        hover-class="option--active"
        bindtap="onReceiptStatusDialogConfirm"
        data-index="{{index}}"
      >
        {{item.desc}}
      </view>
    </view>
    <view class="cancel" hover-class="cancel--active" bindtap="onReceiptStatusDialogConfirm">取消</view>
  </view>
</t-popup>
<!-- 理由选择 -->
<wr-reason-sheet id="wr-reason-sheet" />
<t-dialog id="t-dialog" />
<t-toast id="t-toast" />
<image-processor id="image-processor" />
