<scroll-view class="app-page-scroll" scroll-y enhanced show-scrollbar="{{true}}" bounces="{{false}}" refresher-enabled="{{false}}">
<t-navbar
  t-class-title="app-page-navbar-title"
  title="订单提交结果"
  leftArrow
  fixed="{{false}}"
  background="#fff"
/>
<view class="pay-result">
    <view class="pay-status">
      <text>订单已提交</text>
	</view>
    <view class="pay-money">
		当前状态：待支付，订单金额：
		<price
		 wx:if="{{totalPaid}}"
		 price="{{totalPaid}}"
		 wr-class="pay-money__price"
		 decimalSmaller
		 fill
		/>
	</view>
	<view class="btn-wrapper">
		<view class="status-btn" data-type="orderList" bindtap="onTapReturn">查看订单</view>
		<view class="status-btn" data-type="home" bindtap="onTapReturn">返回首页</view>
	</view>
</view>
</scroll-view>
