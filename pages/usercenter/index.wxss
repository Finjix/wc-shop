page {
  background-color: #fff;
}

.usercenter-custom-nav {
  position: static;
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #111111;
}

.usercenter-custom-nav__content {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: center;
  padding-bottom: 2rpx;
  font-size: var(--app-page-title-font-size, 34rpx);
  font-weight: var(--app-page-title-font-weight, 500);
}

.content-wrapper {
  padding: 24rpx 24rpx calc(env(safe-area-inset-bottom) + 160rpx);
}

.user-profile {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background-color: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.user-profile__avatar {
  display: block;
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
}

.user-profile__name {
  margin-left: 24rpx;
  color: #222222;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 44rpx;
}

.order-group-wrapper {
  margin-bottom: 24rpx;
}

.tools-card {
  overflow: hidden;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.tools-card__header {
  padding: 28rpx 32rpx 8rpx;
  color: #222222;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 52rpx;
}

.tools-list {
  padding: 8rpx 0 16rpx;
}

.tool-item {
  display: flex;
  min-height: 104rpx;
  box-sizing: border-box;
  align-items: center;
  padding: 16rpx 28rpx;
}

.tool-item__icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
}

.tool-item__title {
  flex: 1;
  margin-left: 20rpx;
  color: #333333;
  font-size: 28rpx;
  line-height: 40rpx;
}

.tool-item__arrow {
  flex-shrink: 0;
}

.service-card {
  display: flex;
  width: 100%;
  min-height: 104rpx;
  box-sizing: border-box;
  align-items: center;
  margin-top: 0;
  padding: 16rpx 28rpx;
  border: 0;
  border-radius: 0;
  background: #ffffff;
  box-shadow: none;
  color: inherit;
  font-size: inherit;
  line-height: normal;
  text-align: left;
}

.service-card::after {
  border: 0;
}

.service-card__icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
}

.service-card__title {
  flex: 1;
  margin-left: 20rpx;
  color: #333333;
  font-size: 28rpx;
  line-height: 40rpx;
}

.footer__version {
  margin-top: 40rpx;
  margin-bottom: 4rpx;
  color: #999999;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
}
