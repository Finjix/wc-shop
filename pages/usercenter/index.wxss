page {
  background-color: #f5f5f5;
}

.usercenter-custom-nav {
  position: static;
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #111111;
}

.usercenter-custom-nav__content {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: center;
  padding-bottom: 2rpx;
  font-size: var(--app-page-title-font-size, 34rpx);
  font-weight: var(--app-page-title-font-weight, 500);
}

.content-wrapper {
  padding: 24rpx 24rpx calc(env(safe-area-inset-bottom) + 160rpx);
}

.order-group-wrapper {
  margin-bottom: 24rpx;
}

.tools-card {
  overflow: hidden;
  border-radius: 20rpx;
  background: #ffffff;
}

.tools-card__header {
  padding: 28rpx 32rpx 8rpx;
  color: #222222;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 52rpx;
}

.tools-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 24rpx 16rpx 32rpx;
}

.tool-item {
  display: flex;
  min-height: 156rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tool-item__icon {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  background: #f5f5f5;
}

.tool-item__title {
  margin-top: 16rpx;
  color: #333333;
  font-size: 26rpx;
  line-height: 36rpx;
  text-align: center;
}

.service-card {
  display: flex;
  width: 100%;
  min-height: 104rpx;
  box-sizing: border-box;
  align-items: center;
  margin-top: 24rpx;
  padding: 20rpx 28rpx;
  border: 0;
  border-radius: 20rpx;
  background: #ffffff;
  color: inherit;
  font-size: inherit;
  line-height: normal;
  text-align: left;
}

.service-card::after {
  border: 0;
}

.service-card__icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  background: #f5f5f5;
}

.service-card__title {
  flex: 1;
  margin-left: 20rpx;
  color: #333333;
  font-size: 28rpx;
  line-height: 40rpx;
}

.footer__version {
  margin-top: 0;
  margin-bottom: 4rpx;
  color: #999999;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
}
