<t-navbar
  t-class-content="cart-navbar-content"
  t-class-title="app-page-navbar-title cart-navbar-title"
  title="购物车"
  fixed="{{true}}"
  background="#fff"
/>
<scroll-view
  class="cart-scroll"
  scroll-y
  enhanced
  show-scrollbar="{{true}}"
  bounces="{{false}}"
  refresher-enabled="{{false}}"
>
<view class="cart-page-content" style="padding-top: {{customNavHeight}}px;">
<!-- 分层购物车 -->
<cart-group
  wx:if="{{cartGroupData && cartGroupData.isNotEmpty && !cartLoadError}}"
  store-goods="{{ cartGroupData.storeGoods }}"
  invalid-good-items="{{ cartGroupData.invalidGoodItems }}"
  theme-color="{{themeColor}}"
  bindselectgoods="onGoodsSelect"
  bindselectstore="onStoreSelect"
  bindchangequantity="onQuantityChange"
  bindgoodsclick="goGoodsDetail"
  bindconfirmdelete="onConfirmDeleteRequest"
  bindspecschange="onGoodsSpecsChange"
  bindspecsopen="onSpecsOpen"
  bindclearinvalidgoods="clearInvalidGoods"
  id="cartGroup"
/>

<view wx:if="{{cartLoadError}}" class="cart-load-error">
  <text>购物车加载失败，请重试</text>
  <view class="cart-load-error__retry" bindtap="onRetryCart">重试</view>
</view>

</view>
</scroll-view>

<cart-empty
  wx:if="{{cartGroupData && !cartGroupData.isNotEmpty && !cartLoadError}}"
  top="{{customNavHeight}}"
/>

<specs-popup
  show="{{specPopup.show}}"
  title="{{specPopup.title}}"
  price="{{specPopup.price}}"
  thumb="{{specPopup.thumb}}"
  spec-list="{{specPopup.specList}}"
  sku-list="{{specPopup.skuList}}"
  selected-sku-id="{{specPopup.selectedSkuId}}"
  theme-color="{{themeColor}}"
  zIndex="{{20000}}"
  bindclose="onSpecsClose"
  bindconfirm="onSpecsConfirm"
/>

<!-- 商品小计以及结算按钮 -->
<cart-bar
  wx:if="{{cartGroupData && cartGroupData.isNotEmpty && !cartLoadError}}"
  is-all-selected="{{cartGroupData.isAllSelected}}"
  total-amount="{{cartGroupData.totalAmount}}"
  total-goods-num="{{cartGroupData.selectedGoodsCount}}"
  theme-color="{{themeColor}}"
  fixed="{{true}}"
  bottomHeight="{{100}}"
  bindhandleSelectAll="onSelectAll"
  bindhandleToSettle="onToSettle"
/>
<t-toast id="t-toast" />
<t-dialog
  id="t-dialog"
  t-class-confirm="cart-delete-dialog-confirm"
  visible="{{deleteDialogVisible}}"
  title="移出购物车"
  bindconfirm="confirmDeleteGoods"
  bind:close="closeDeleteDialog"
  confirm-btn="{{ {content: '确定', style: 'order: -1; margin-left: 0;'} }}"
  cancel-btn="取消"
/>
