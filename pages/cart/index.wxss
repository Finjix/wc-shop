page {
  background-color: #fff !important;
}

:host {
  display: block;
  height: 100vh;
  min-height: 0;
  overflow: hidden;
  padding-bottom: 0;
  background-color: #fff;
}

.cart-scroll {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
}

.cart-page-content {
  box-sizing: border-box;
  min-height: 100%;
  padding-bottom: calc(224rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.cart-navbar-content {
  --td-navbar-bg-color: #fff;
  --td-navbar-color: #111;
  background-color: #fff !important;
  color: #111 !important;
}

.cart-navbar-title {
  color: #111 !important;
}

.cart-recommend-section {
  background: transparent;
  font-family: 'Microsoft YaHei', '微软雅黑', 'MicrosoftJhengHei', '华文细黑', Helvetica, Arial, sans-serif;
}

.cart-recommend-title {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 24rpx 28rpx;
  color: #999;
  background: transparent;
  font-size: 32rpx;
  line-height: 44rpx;
}

.cart-recommend-title text {
  margin: 0 20rpx;
  white-space: nowrap;
}

.cart-recommend-title__line {
  width: 112rpx;
  height: 2rpx;
  background: #d9d9d9;
}

.cart-recommend-frame {
  display: flex;
  justify-content: space-between;
  margin: 0 12rpx;
  padding: 24rpx;
  background: transparent;
}

.cart-recommend-column {
  width: calc((100% - 16rpx) / 2);
}

.cart-recommend-card {
  display: flex;
  width: 100%;
  height: calc((100vw - 88rpx) / 2);
  min-height: 0;
  flex-direction: column;
  margin-bottom: 16rpx;
  overflow: hidden;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.cart-recommend-card__image-wrap {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
  overflow: hidden;
  background: #fff;
  border-radius: 20rpx;
}

.cart-recommend-card__image-wrap .hot-product-card__image {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

.cart-recommend-loading {
  padding: 16rpx 24rpx 32rpx;
  color: #8a8f98;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.t-button {
  --td-button-default-color: #000;
  --td-button-primary-text-color: #fff;
}

.cart-delete-dialog-confirm {
  color: var(--app-theme-text-color, #695941) !important;
  --td-button-primary-text-color: var(--app-theme-text-color, #695941);
}
