.goods-category {
  display: flex;
  height: 100%;
  min-height: 0;
  background-color: #fff;
  font-family: 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
}

.custom-sidebar {
  height: 100%;
}

.goods-category__right {
  height: 100%;
  flex: 1;
  width: 0;
  min-height: 0;
  position: relative;
  background-color: #fff !important;
}

.flex {
  display: flex;
}

.goods-category-normal {
  margin: 28rpx 34rpx 0rpx 32rpx;
  box-sizing: border-box;
  min-height: 100%;
  padding-bottom: calc(env(safe-area-inset-bottom) + 96rpx);
  background-color: #fff;
}

.goods-category-normal-item-title {
  font-size: 28rpx;
  color: #222427;
  font-family: 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  font-weight: 600;
}

.goods-category-normal-item-banner {
  display: block;
  width: 100%;
  height: auto;
  margin-bottom: 24rpx;
}

.goods-category-normal-item-container {
  padding-top: 28rpx;
  margin-top: -24rpx;
  margin-bottom: 30rpx;
  display: flex;
  flex-wrap: wrap;
}

.goods-category-normal-item-container--banner {
  padding-top: 0;
  margin-top: 0;
}

.goods-category-normal-item-container-item {
  height: 196rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
  width: 33.3%;
}

.goods-category-normal-item-container-item .image {
  width: 144rpx;
  height: 144rpx;
}

.goods-category-normal-item-container-item-title {
  justify-content: center;
  font-size: 28rpx;
  color: #222427;
  font-family: 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  font-weight: 400;
  margin-top: 20rpx;
}

.goods-category .custom-sidebar {
  background-color: #f5f5f5;
}

.custom-sidebar {
  width: 180rpx;
  height: 100%;
  background-color: #f5f5f5;
}

.custom-sidebar::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

.goods-category-normal-item-second-container {
  background-color: #fff;
  border-radius: 8rpx;
  margin-top: 8rpx;
  margin-bottom: 30rpx;
  display: grid;
  grid-template-columns: 33.33% 33.33% 33.33%;
}

.goods-category-normal-item-second-container-item {
  height: 200rpx;
  text-align: center;
  margin-top: 20rpx;
}

.goods-category-normal-item-second-container-item .image {
  width: 144rpx;
  height: 144rpx;
}

.goods-category-normal-item-second-container-item-title {
  justify-content: center;
  font-size: 28rpx;
  color: #222427;
  font-family: 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  font-weight: 400;
}
