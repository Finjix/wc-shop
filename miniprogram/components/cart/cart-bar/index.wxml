<view class="cart-bar__placeholder" wx:if="{{fixed}}" />
<view class="{{fixed ? 'cart-bar--fixed' : ''}}" style="padding-bottom: {{fixed ? 'calc(' + bottomHeight + 'rpx + env(safe-area-inset-bottom))' : '0'}};">
<view class="cart-bar flex flex-v-center">
	<t-icon
	 size="40rpx"
	 color="{{isAllSelected ? themeColor : '#BBBBBB'}}"
	 name="{{isAllSelected ? 'check-circle-filled' : 'circle'}}"
	 class="cart-bar__check"
	 catchtap="handleSelectAll"
	/>
	<text>全选</text>
	<view class="cart-bar__total flex1">
		<view>
			<text class="cart-bar__total--bold text-padding-right">合计</text>
			<price
			 price="{{totalAmount || '0'}}"
			 fill="{{false}}"
			 decimalSmaller
			 class="cart-bar__total--bold cart-bar__total--price"
			/>
		</view>
	</view>
	<view catchtap="handleToSettle" class="{{isDisabled ? 'disabled-btn' : ''}} account-btn" hover-class="{{isDisabled ? 'hover-btn' : ''}}">
		结算
	</view>
</view>
</view>
