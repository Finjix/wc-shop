<t-navbar
  t-class-title="app-page-navbar-title"
  title="我的订单"
  leftArrow
  fixed="{{false}}"
  background="#fff"
/>
<view class="page-container">
  <view class="tab-bar">
    <view class="tab-bar__placeholder" />
    <t-tabs
      t-class="tab-bar__inner"
      t-class-active="tab-bar__active"
      t-class-track="t-tabs-track"
      bind:change="onTabChange"
      value="{{status}}"
    >
      <t-tab-panel
        wx:for="{{tabs}}"
        wx:for-index="index"
        wx:for-item="item"
        wx:key="index"
        label="{{item.text}}"
        value="{{item.key}}"
      />
    </t-tabs>
  </view>
  <t-pull-down-refresh top-inset="{{88}}" bind:reachbottom="onReachBottom"
    id="pull-down-refresh"
    normal-bar-height="{{200}}"
    max-bar-height="{{272}}"
    refreshTimeout="{{3000}}"
    background="#f5f5f5"
    use-loading-slot
    loading-size="60rpx"
    value="{{pullDownRefreshing}}"
    bindrefresh="onPullDownRefresh"
    t-class-indicator="t-class-indicator"
  >
    <block wx:for="{{orderList}}" wx:key="id" wx:for-item="order" wx:for-index="oIndex">
    <order-card
      order="{{order}}"
      defaultShowNum="{{3}}"
      data-order="{{order}}"
      bindcardtap="onOrderCardTap"
      useLogoSlot
    >
      <view slot="top-left" class="order-number">
        <text decode>订单号&nbsp;</text>
        {{order.orderNo}}
      </view>
      <specs-goods-card
        bind:thumb="onGoodsThumb"
        wx:for="{{order.goodsList}}"
        wx:key="id"
        wx:for-item="goods"
        wx:for-index="gIndex"
        data="{{goods}}"
        no-top-line="{{gIndex === 0}}"
      />
      <view slot="more">
        <!-- 实付金额与订单操作按钮保持在同一行 -->
        <order-button-bar
          order="{{order}}"
          showAmount="{{true}}"
          bindrefresh="onRefresh"
          data-order="{{order}}"
        />
      </view>
    </order-card>
    <view wx:if="{{oIndex < orderList.length - 1}}" class="order-list-divider" />
    </block>
    <!-- 保留加载、重试和空态，列表结束时不显示提示 -->
    <load-more
      wx:if="{{!pullDownRefreshing && (listLoading !== 2 || !orderList.length)}}"
      list-is-empty="{{!orderList.length}}"
      status="{{listLoading}}"
      bindretry="onReTryLoad"
    >
      <view slot="empty" class="commerce-empty">暂无订单</view>
    </load-more>
  </t-pull-down-refresh>
</view>
