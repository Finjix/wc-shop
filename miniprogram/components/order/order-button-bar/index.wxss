:host {
  display: block;
  width: 100%;
  min-width: 0;
}
.btn-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 72rpx;
  line-height: 1;
}
.btn-bar .order-pay-amount {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  color: #333333;
  font-size: 28rpx;
  line-height: 40rpx;
}
.btn-bar .order-pay-amount__label {
  margin-right: 8rpx;
}
.btn-bar .order-pay-amount__price {
  color: #000000;
  font-size: 36rpx;
  font-weight: bold;
}

.btn-bar .order-btn {
  line-height: 1.4;
}

.btn-bar .right {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 16rpx;
  align-items: center;
  margin-left: 16rpx;
}
.btn-bar .t-button {
  width: 160rpx;
  font-weight: 400;
  margin-left: 0;
}
.btn-bar .t-button--max {
  width: 176rpx;
  margin-left: 0;

}

.btn-bar .right .normal {
  --ui-button-background: #fff;
  --ui-button-color: #333333;
  --ui-button-border: #dddddd;
}

.btn-bar .right .primary {
  --ui-button-color: #fff;
  --ui-button-background: var(--app-theme-color, #695941);
  --ui-button-border: var(--app-theme-color, #695941);

}

.t-button {
  --ui-button-color: #000;
  color: #695941;
}
