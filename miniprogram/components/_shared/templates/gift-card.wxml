<template name="gift-card">
  <view class="home-gift-card" data-product-id="{{product.spuId}}" bind:tap="navToConfiguredProduct">
    <image class="home-gift-card__cover" src="{{product.thumb}}" mode="aspectFill" lazy-load />
    <view class="home-gift-card__body">
      <text class="home-gift-card__title">{{product.title}}</text>
      <view class="home-gift-card__footer">
        <price class="home-gift-card__price" wr-class="home-gift-card__price" symbol-class="home-gift-card__symbol" price="{{product.price}}" />
        <button class="home-gift-card__cart" data-product-id="{{product.spuId}}" catch:tap="addFeedProductToCart" aria-label="选择规格加入购物车"><t-icon prefix="wr" name="cartAdd" size="36rpx" color="#695941" /></button>
      </view>
    </view>
  </view>
</template>
