<root-portal>
<view wx:if="{{visible}}" class="overlay" catchtouchmove="noop"><view class="mask" bindtap="cancel" /><view class="dialog"><text class="dialog-title">{{title}}</text><view class="dialog-body"><text wx:if="{{content}}" class="dialog-message">{{content}}</text><slot name="content" /><slot /></view><view class="dialog-actions t-class-action"><button wx:if="{{confirmBtn !== null && confirmBtn !== false}}" class="dialog-action t-class-confirm" disabled="{{confirmBtn.disabled || confirmBtn.loading}}" bindtap="confirm">{{confirmBtn.content || confirmBtn}}</button><button wx:if="{{cancelBtn !== null && cancelBtn !== false}}" class="dialog-action t-class-cancel" disabled="{{cancelBtn.disabled}}" bindtap="cancel">{{cancelBtn.content || cancelBtn}}</button><button class="dialog-action" wx:for="{{actions}}" wx:key="index" data-index="{{index}}" bindtap="action">{{item.content}}</button></view></view></view>
</root-portal>
