<view class="uploads"><view wx:for="{{files}}" wx:key="index" class="upload-item"><image class="upload-image" src="{{item.url || item.tempFilePath}}" mode="aspectFill" data-index="{{index}}" bindtap="previewFile" /><view class="upload-remove" wx:if="{{!disabled}}" data-index="{{index}}" catchtap="removeFile">×</view></view><view wx:if="{{files.length < max}}" class="upload-item upload-add" bindtap="chooseFiles"><slot name="add-content" /></view></view>
