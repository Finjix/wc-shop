<view class="stepper"><button class="stepper-button" disabled="{{disabled || value <= min}}" data-action="-1" catchtap="changeQuantity"><text class="stepper-sign">−</text></button><input class="quantity-input" type="number" value="{{value}}" disabled="{{disabled}}" bindblur="quantityBlur" /><button class="stepper-button" disabled="{{disabled || value >= max}}" data-action="1" catchtap="changeQuantity"><text class="stepper-sign">+</text></button></view>
