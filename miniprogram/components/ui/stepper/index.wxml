<view class="stepper"><button class="stepper-button" size="mini" disabled="{{disabled || value <= min}}" data-action="-1" catchtap="changeQuantity">−</button><input class="quantity-input" type="number" value="{{value}}" disabled="{{disabled}}" bindblur="quantityBlur" /><button class="stepper-button" size="mini" disabled="{{disabled || value >= max}}" data-action="1" catchtap="changeQuantity">＋</button></view>
