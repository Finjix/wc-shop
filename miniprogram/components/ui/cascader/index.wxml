<view wx:if="{{visible}}" class="overlay" catchtouchmove="noop"><view class="mask" bindtap="close" /><view class="popup bottom"><view class="area-heading">{{title}}<text bindtap="close">关闭</text></view><view class="area-columns"><scroll-view wx:for="{{areaColumns}}" wx:for-item="column" wx:for-index="columnIndex" wx:key="index" scroll-y class="area-column"><view wx:for="{{column}}" wx:for-item="option" wx:key="value" class="area-option" data-column="{{columnIndex}}" data-index="{{index}}" bindtap="chooseArea">{{option.label}}</view></scroll-view></view></view></view>
