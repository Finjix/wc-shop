<swiper class="t-class" style="height:{{heightStyle}};width:100%" autoplay="{{autoplay}}" current="{{current}}" circular="{{circular}}" duration="{{duration}}" interval="{{interval}}" bindchange="changeSlide"><swiper-item wx:for="{{slideItems}}" wx:key="key" data-index="{{index}}" bindtap="tapSlide"><image class="slide-image t-class-image" src="{{item.src}}" mode="{{imageProps.mode || 'aspectFill'}}" show-menu-by-longpress="{{imageProps.showMenuByLongpress}}" /></swiper-item></swiper>
