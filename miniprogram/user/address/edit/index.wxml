<scroll-view class="app-page-scroll" scroll-y enhanced show-scrollbar="{{true}}" bounces="{{false}}" refresher-enabled="{{false}}">
<t-navbar
  t-class-title="app-page-navbar-title"
  title="设置地址"
  leftArrow
  fixed="{{false}}"
  background="#fff"
/>
<view class="address-detail">
  <view class="divider-line" />
  <view class="form-address">
    <form class="form-content">
      <t-cell-group>
        <view class="address-field-row">
          <label class="address-field-label" for="address-name">收货人</label>
          <input id="address-name" class="address-field-control" value="{{locationState.name}}" placeholder="您的姓名" placeholder-class="address-field-placeholder" maxlength="20" data-item="name" bindinput="onInputValue" />
        </view>
        <view class="address-field-row">
          <label class="address-field-label" for="address-phone">手机号</label>
          <input id="address-phone" class="address-field-control" value="{{locationState.phone}}" placeholder="联系您的手机号" placeholder-class="address-field-placeholder" type="number" maxlength="11" data-item="phone" bindinput="onInputValue" />
        </view>
        <view class="address-field-row address-field-row--address">
          <label class="address-field-label" for="address-full">地址</label>
          <textarea id="address-full" class="address-field-control address-field-textarea" value="{{locationState.detailAddress}}" placeholder="精确到门牌号" placeholder-class="address-field-placeholder" maxlength="240" auto-height data-item="detailAddress" bindinput="onInputValue" />
        </view>
        <view class="divider-line" />
        <t-cell title="设置为默认收货地址" bordered="{{false}}">
          <t-switch
            value="{{locationState.isDefault}}"
            slot="note"
            colors="{{['#695941', '#c6c6c6']}}"
            bind:change="onCheckDefaultAddress"
          />
        </t-cell>
      </t-cell-group>
      <view class="submit">
        <t-button
          t-class="btn-submit-address"
          shape="round"
          block
          bind:tap="formSubmit"
        >
          保存
        </t-button>
      </view>
    </form>
  </view>
</view>
</scroll-view>
