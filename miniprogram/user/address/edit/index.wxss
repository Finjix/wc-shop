page {
  background-color: #fff;
}
page .divider-line {
  width: 100%;
  height: 20rpx;
  background-color: #fff;
}
.address-detail {
  font-size: 30rpx;
}

.address-field-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
  box-sizing: border-box;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #eee;
}
.address-field-row--address {
  align-items: flex-start;
  border-bottom: 0;
}
.address-field-label {
  flex: none;
  width: 144rpx;
  color: #111;
  font-size: 28rpx;
  line-height: 44rpx;
}
.address-field-control {
  display: block;
  flex: 1;
  min-width: 0;
  width: 100%;
  height: 44rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  color: #333;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
  text-align: right;
}
.address-field-textarea { min-height: 44rpx; }
.address-field-placeholder { color: #c4c4c4; font-size: 28rpx; font-weight: 400; line-height: 44rpx; }

.submit {
  box-sizing: border-box;
  padding: 64rpx 30rpx 88rpx 30rpx;
}
.submit .btn-submit-address {
  --ui-button-weight: 700;
  --ui-button-color: #fff;
  --ui-button-background: #695941;
  --ui-button-border: #695941;

  background: #695941 !important;
  color: #fff !important;
  font-weight: 700;
}
