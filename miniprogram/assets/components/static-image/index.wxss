@import './promo-frames.wxss';
/* Ordinary image/view nodes scroll together; no native Canvas overlay. */
.promo-frame-window { position: relative; display: block; overflow: hidden; }
.promo-frame-sheet { position: absolute; top: 0; left: 0; display: block; max-width: none; pointer-events: none; }
.promo-frame-fallback { position: absolute; top: 0; left: 0; display: block; width: 100%; height: 100%; pointer-events: none; }
