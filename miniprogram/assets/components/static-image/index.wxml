<view wx:if="{{asset === 'invite-cashback' || asset === 'customer-gift'}}" class="promo-frame-window" style="width:{{size}};height:{{size}};">
  <block wx:if="{{asset === 'invite-cashback'}}">
    <image class="promo-frame-fallback" hidden="{{framesReady}}" src="../../home/invite-cashback-poster-v261025.jpg" mode="aspectFill" />
    <image class="promo-frame-sheet promo-frame-sheet--invite" src="../../home/invite-cashback-frames-v261025.jpg" mode="scaleToFill" style="opacity:{{framesReady ? 1 : 0}};animation-play-state:{{framesPlaying ? 'running' : 'paused'}};" bindload="onFrameLoad" binderror="onFrameError" />
  </block>
  <block wx:else>
    <image class="promo-frame-fallback" hidden="{{framesReady}}" src="../../home/customer-gift-poster-v261025.jpg" mode="aspectFill" />
    <image class="promo-frame-sheet promo-frame-sheet--gift" src="../../home/customer-gift-frames-v261025.jpg" mode="scaleToFill" style="opacity:{{framesReady ? 1 : 0}};animation-play-state:{{framesPlaying ? 'running' : 'paused'}};" bindload="onFrameLoad" binderror="onFrameError" />
  </block>
</view>
<image wx:elif="{{asset === 'recommend-heart'}}" style="display:block;width:{{size}};height:{{size}};" src="../../home/recommend-heart.png" mode="aspectFit" />
<image wx:elif="{{asset === 'gift-star'}}" style="display:block;width:{{size}};height:{{size}};" src="../../home/gift-star.png" mode="aspectFit" />
<image wx:elif="{{asset === 'default-avatar'}}" style="display:block;width:{{size}};height:{{size}};" src="../../user/default-avatar.jpg" mode="aspectFill" />
