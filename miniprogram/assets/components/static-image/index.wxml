<view wx:if="{{asset === 'invite-cashback' || asset === 'customer-gift'}}" class="promo-frame-window" style="width:{{size}};height:{{size}};">
  <image wx:if="{{asset === 'invite-cashback'}}" class="promo-frame-sheet" src="../../home/invite-cashback-frames-v261025.webp" mode="scaleToFill" />
  <image wx:else class="promo-frame-sheet" src="../../home/customer-gift-frames-v261025.webp" mode="scaleToFill" />
</view>
<image wx:elif="{{asset === 'recommend-heart'}}" style="display:block;width:{{size}};height:{{size}};" src="../../home/recommend-heart.png" mode="aspectFit" />
<image wx:elif="{{asset === 'gift-star'}}" style="display:block;width:{{size}};height:{{size}};" src="../../home/gift-star.png" mode="aspectFit" />
<image wx:elif="{{asset === 'default-avatar'}}" style="display:block;width:{{size}};height:{{size}};" src="../../user/default-avatar.jpg" mode="aspectFill" />
