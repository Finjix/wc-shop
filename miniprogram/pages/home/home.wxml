<top-search
  top="{{searchTop}}"
  left="{{searchLeft}}"
  width="{{searchWidth}}"
  value="{{searchValue}}"
  focus="{{searchFocus}}"
  search-background="rgba(255,255,255,0.5)"
  bind:focus="handleSearchFocus"
  bind:blur="handleSearchBlur"
  bind:change="handleSearchChange"
  bind:submit="handleSearchSubmit"
/>

<scroll-view class="home-scroll" scroll-y show-scrollbar="{{true}}" bounces="{{false}}" refresher-enabled="{{false}}" lower-threshold="200" bindscroll="onFeedScroll" bindtouchstart="onFeedTouchStart" bindtouchmove="onFeedTouchMove" bindscrolltolower="onFeedBottom">
  <view class="home-scroll-content">
    <view wx:if="{{loadError}}" class="home-load-error">
      <text>{{loadError}}</text>
      <button class="home-load-error__retry" size="mini" bind:tap="loadHomePage">重新加载</button>
    </view>
    <view class="swiper-wrap" wx:if="{{swiperSlides.length}}">
      <t-swiper
        t-class="home-swiper"
        t-class-image="home-swiper__image"
        height="1333.333rpx"
        current="{{current}}"
        autoplay="{{autoplay}}"
        duration="{{duration}}"
        interval="{{interval}}"
        navigation="{{false}}"
        imageProps="{{swiperImageProps}}"
        list="{{swiperSlides}}"
        bind:click="navToGoodsDetail"
      />
    </view>

    <view class="home-promo-cards">
      <view class="home-promo-card">
        <static-image class="home-promo-card__image" asset="invite-cashback" size="calc((100vw - 8rpx) / 2)" />
        <button class="home-promo-card__action" bind:tap="showInviteComingSoon" aria-label="邀请返现"></button>
      </view>
      <view class="home-promo-card">
        <static-image class="home-promo-card__image" asset="customer-gift" size="calc((100vw - 8rpx) / 2)" />
        <button class="home-promo-card__action" open-type="contact" aria-label="加客服拿好礼"></button>
      </view>
    </view>

    <view wx:if="{{recommendations.length}}" class="home-recommendations">
      <view class="showcase-heading showcase-heading--heart" aria-label="倾心推荐">
        <view class="showcase-heading__mascot"><static-image asset="recommend-heart" size="64px" /></view>
        <view class="showcase-heading__words"><text wx:for="{{heartTitle}}" wx:key="index" class="showcase-heading__letter" style="animation-delay:{{index * 0.16}}s">{{item}}</text></view>
        <text class="showcase-heading__sparkle" aria-hidden="true">✦</text>
      </view>
      <swiper class="home-recommendation-swiper" current="{{recommendationCurrent}}" autoplay="{{false}}" circular="{{recommendations.length > 1}}" duration="500" previous-margin="75rpx" next-margin="75rpx" bindchange="onRecommendationChange">
        <swiper-item wx:for="{{recommendationSlides}}" wx:key="index">
          <view class="home-recommendation-card {{index === recommendationCurrent ? 'home-recommendation-card--current' : ''}}" data-product-id="{{item.productId}}" bind:tap="navToConfiguredProduct" aria-label="{{item.title}}">
            <image class="home-recommendation-card__image" src="{{item.image}}" mode="aspectFill" lazy-load />
          </view>
        </swiper-item>
      </swiper>
    </view>

    <view class="home-gifts">
      <view class="showcase-heading showcase-heading--star" aria-label="更多献礼">
        <text class="showcase-heading__sparkle" aria-hidden="true">✧</text>
        <view class="showcase-heading__words"><text wx:for="{{giftTitle}}" wx:key="index" class="showcase-heading__letter" style="animation-delay:{{index * 0.2}}s">{{item}}</text></view>
        <view class="showcase-heading__mascot"><static-image asset="gift-star" size="64px" /></view>
      </view>
      <view class="home-gift-grid">
        <view wx:for="{{feedItems}}" wx:key="feedKey" class="home-gift-card" data-product-id="{{item.spuId}}" bind:tap="navToConfiguredProduct">
          <image class="home-gift-card__cover" src="{{item.thumb}}" mode="aspectFill" lazy-load />
          <view class="home-gift-card__body">
            <text class="home-gift-card__title">{{item.title}}</text>
            <view class="home-gift-card__footer">
              <price class="home-gift-card__price" wr-class="home-gift-card__price" symbol-class="home-gift-card__symbol" price="{{item.price}}" />
              <button class="home-gift-card__cart" data-product-id="{{item.spuId}}" catch:tap="addFeedProductToCart" aria-label="选择规格加入购物车"><t-icon prefix="wr" name="cartAdd" size="36rpx" color="#695941" /></button>
            </view>
          </view>
        </view>
      </view>
      <view class="home-feed-status">
        <t-loading wx:if="{{feedLoading}}" theme="circular" size="32rpx" text="加载中" />
        <button wx:elif="{{feedError}}" class="home-feed-retry" bind:tap="loadMoreFeed">{{feedError}} · 点击重试</button>
        <text wx:elif="{{feedEmpty}}">好礼准备中，敬请期待</text>
      </view>
    </view>

    <view style="text-align: center; color: #b9b9b9" wx:if="{{pageLoading}}">
      <t-loading theme="circular" size="40rpx" text="" inherit-color />
    </view>
  </view>
</scroll-view>
