@import '../../style/iconfont.wxss';
.wrap { display: flex; flex-direction: column; height: 100vh; overflow: hidden; background: #fff; }
.category-header { position: relative; flex: 0 0 auto; background: #fff; }
.category-custom-nav { box-sizing: border-box; }
.category-main { display: flex; min-height: 0; background: #fff; }
.category-sidebar { flex: 0 0 180rpx; width: 180rpx; height: 100%; background: #fff; }
.category-parent { box-sizing: border-box; padding: 28rpx 10rpx; color: #222427; font-size: 28rpx; font-weight: 400; text-align: center; white-space: nowrap; }
.category-parent.active { color: #222427; background: #f5f5f5; }
.category-right { display: flex; flex: 1; flex-direction: column; min-width: 0; min-height: 0; border-left: 1px solid #eee; background: #fff; }
.category-products { flex: 1; min-height: 0; box-sizing: border-box; padding: 0 24rpx; }
.category-products-content { padding: 28rpx 0 40rpx; }
.category-section { margin-bottom: 48rpx; }
.category-section:last-child { margin-bottom: 0; }
.category-section-title { display: flex; align-items: center; margin: 0 0 24rpx; color: #695941; font-size: 28rpx; font-weight: 600; white-space: nowrap; }
.category-section-label { flex: 0 0 auto; }
.category-section-divider { flex: 1; min-width: 0; height: 1rpx; margin-left: 16rpx; background: #e9e9e9; }
.category-section-banner { display: block; width: 100%; height: auto; margin: 0 0 24rpx; background: #f5f5f5; }
.category-section-banner-rounded { border-radius: 16rpx; overflow: hidden; }
.category-product-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28rpx 14rpx; }
.category-product-item { min-width: 0; }
.category-product-card { position: relative; min-width: 0; height: 0; padding-top: 100%; overflow: hidden; border-radius: 16rpx; }
.category-product-image { position: absolute; top: 0; left: 0; display: block; box-sizing: border-box; width: 100%; height: 100%; }
.category-product-name { display: block; white-space: nowrap; margin: 14rpx 0 0; height: 36rpx; color: #37332e; font-size: 26rpx; line-height: 36rpx; text-align: center; }
.category-state, .category-status { padding: 50rpx 20rpx; color: #999; font-size: 26rpx; text-align: center; }
