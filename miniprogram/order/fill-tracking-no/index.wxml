<scroll-view class="app-page-scroll" scroll-y enhanced show-scrollbar="{{true}}" bounces="{{false}}" refresher-enabled="{{false}}">
<t-navbar
  t-class-title="app-page-navbar-title"
  title="售后详情"
  leftArrow
  fixed="{{false}}"
  background="#fff"
/>
<view class="fill-tracking-no">
  <view class="fill-tracking-no__form">
    <t-cell-group>
      <t-cell title="运单号" t-class-title="t-cell-title-width">
        <t-input
          slot="note"
          borderless
          t-class="t-cell__value"
          type="text"
          value="{{trackingNo}}"
          maxlength="30"
          placeholder="请输入物流单号"
          bind:change="onInput"
          data-key="trackingNo"
        />

      </t-cell>
    </t-cell-group>
  </view>
  <view class="fill-tracking-no__button-bar">
    <t-button
      t-class="btn {{ submitActived ? 'confirmBtn' : '' }}"
      disabled="{{!submitActived}}"
      loading="{{submitting}}"
      bindtap="onSubmit"
    >
      保存
    </t-button>
  </view>
</view>
</scroll-view>
<t-toast id="t-toast" />
<t-dialog id="t-dialog" />
