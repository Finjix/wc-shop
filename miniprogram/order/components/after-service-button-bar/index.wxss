:host {
  display: block;
  width: 100%;
  min-width: 0;
}
.btn-bar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  line-height: 1;
}
.btn-bar .right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 20rpx;
}
.btn-bar .order-btn {
  background-color: inherit;
  font-size: 26rpx;
  padding: 16rpx 28rpx;
  line-height: 1;
  border-radius: unset;
  min-width: 160rpx;
  border-radius: 32rpx;
  height: 60rpx;
  margin: 0;
}

.btn-bar .left .order-btn:not(:first-child),
.btn-bar .right .order-btn:not(:first-child) {
  margin-left: 0;
}
.btn-bar .left .delete-btn {
  font-size: 22rpx;
}
.btn-bar .left .delete-btn::after {
  display: none;
}

.btn-bar .right .normal {
  --ui-button-color: #333333;
  --ui-button-border: #dddddd;
}

.btn-bar .right .primary {
  --ui-button-color: #fff;
  --ui-button-background: #695941;
  --ui-button-border: #695941;

}
