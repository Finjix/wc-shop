page {
  --app-theme-color: #695941;
  --app-theme-color-soft: #f2f2f2;
  --app-theme-text-color: #695941;
  background-color: #fff;
  --app-page-title-font-size: 34rpx;
  --app-page-title-font-weight: 500;

}

.dialog__button-confirm {
  color: #695941 !important;
}

.dialog__button-cancel {
  color: #aeb3b7 !important;
}

.app-page-scroll {
  display: block;
  width: 100%;
  height: 100vh;
  min-height: 0;
  box-sizing: border-box;
  background-color: #fff;
}

.app-page-navbar-title {
  font-size: var(--app-page-title-font-size, 34rpx) !important;
  font-weight: var(--app-page-title-font-weight, 500) !important;
}

.cell--noborder .t-cell::after {
  border-bottom: none !important;
}

.commerce-dialog-confirm {
  color: #695941;
}
