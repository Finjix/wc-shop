@import '../../style/gift-card.wxss';

.home-scroll { position: absolute; top: 0; left: 0; width: 100%; height: calc(100vh - 100rpx - env(safe-area-inset-bottom)); }
.home-scroll-content { --gift-card-cover-background: #f0ece3; position: relative; background: #FCF8EE; padding-bottom: calc(env(safe-area-inset-bottom) + 80rpx + 64rpx); }
.swiper-wrap { width: 100%; margin: 0; background: #FCF8EE; }
.swiper-wrap .home-swiper,
.swiper-wrap .t-swiper-host { width: 100%; border-radius: 0 !important; overflow: hidden; }
.swiper-wrap .home-swiper__image,
.swiper-wrap .t-swiper__image { width: 100% !important; height: 1333.333rpx !important; background: #FCF8EE; border-radius: 0 !important; }

.home-promo-cards { display: flex; gap: 8rpx; margin-top: 8rpx; background: #FCF8EE; }
.home-promo-card { position: relative; width: calc((100% - 8rpx) / 2); height: calc((100vw - 8rpx) / 2); }
.home-promo-card__action { position: absolute; top: 0; left: 0; z-index: 1; display: block; width: 100%; height: 100%; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; }
.home-promo-card__action::after { border: 0; }
.home-promo-card__image { position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: block; width: 100%; height: 100%; }

.showcase-heading { display: flex; align-items: center; justify-content: center; gap: 12rpx; min-height: 64px; padding: 40rpx 24rpx 28rpx; }
.showcase-heading__mascot { display: flex; align-items: center; justify-content: center; width: 64px; height: 64px; flex: 0 0 64px; }
.showcase-heading--heart .showcase-heading__mascot { transform-origin: 50% 50%; animation: heart-mascot 2.5s ease-in-out infinite; }
.showcase-heading--star .showcase-heading__mascot { transform-origin: 50% 60%; animation: star-mascot 3s ease-in-out infinite; }
.showcase-heading__words { display: flex; align-items: center; white-space: nowrap; }
.showcase-heading__letter { display: inline-block; font-family: 'YouYuan', '幼圆', 'PingFang SC', sans-serif; font-size: 48rpx; font-weight: 900; line-height: 1.5; letter-spacing: 4rpx; }
.showcase-heading--heart .showcase-heading__letter { color: #dc7995; text-shadow: 2rpx 2rpx 0 #fff6db, -2rpx -2rpx 0 #fff6db, 0 5rpx 0 #f5c0c5; animation: heart-letter 2.5s ease-in-out infinite; }
.showcase-heading__sparkle { font-size: 32rpx; color: #e6ad76; animation: heading-sparkle 1.8s ease-in-out infinite; }
.showcase-heading--star .showcase-heading__letter { color: #789eb8; text-shadow: 2rpx 2rpx 0 #fff8ce, -2rpx -2rpx 0 #fff8ce, 0 5rpx 0 #d5e4e8; animation: star-letter 3s ease-in-out infinite; }
.showcase-heading--star .showcase-heading__sparkle { color: #e4b43b; animation-duration: 2.4s; }
@keyframes heart-letter { 0%, 60%, 100% { transform: translateY(0) rotate(0); opacity: 1; } 20% { transform: translateY(-6rpx) rotate(-4deg); color: #ed9cae; } 35% { transform: translateY(0) rotate(3deg); } }
@keyframes star-letter { 0%, 100% { transform: translateY(0) rotate(-2deg); } 35% { transform: translateY(-5rpx) rotate(2deg); color: #acc6d7; } 65% { transform: translateY(2rpx) rotate(0); } }
@keyframes heading-sparkle { 0%, 100% { opacity: .35; transform: scale(.7) rotate(-15deg); } 50% { opacity: 1; transform: scale(1.15) rotate(20deg); } }
@keyframes heart-mascot { 0%, 60%, 100% { transform: scale(1) rotate(0); } 20% { transform: scale(1.08) rotate(-5deg); } 35% { transform: scale(1.02) rotate(4deg); } }
@keyframes star-mascot { 0%, 100% { transform: translateY(0) rotate(-8deg) scale(1); opacity: .9; } 35% { transform: translateY(-7rpx) rotate(8deg) scale(1.06); opacity: 1; } 65% { transform: translateY(2rpx) rotate(0) scale(.98); opacity: .85; } }

/* Keep native touch coordinates; automatic rotation is driven by current. */
.home-recommendation-swiper { width: 100%; height: calc(100vw * 0.8 * 16 / 9 + 32rpx); }
.home-recommendation-card { width: 100%; height: calc(100vw * 0.8 * 16 / 9); overflow: hidden; border-radius: 48rpx; box-shadow: 0 10rpx 22rpx rgba(105, 89, 65, .12); opacity: .72; transform: scale(.84); transition: transform 500ms ease, opacity 500ms ease; }
.home-recommendation-card--current { transform: scale(1); opacity: 1; }
.home-recommendation-card__image { display: block; width: 100%; height: 100%; }

.home-feed-status { display: flex; align-items: center; justify-content: center; min-height: 100rpx; padding: 16rpx 24rpx; color: #a09689; font-size: 24rpx; }
.home-feed-retry { padding: 8rpx 16rpx; color: #88715a; font-size: 24rpx; background: transparent; }
.home-feed-retry::after { border: 0; }
.home-load-error { padding: 32rpx; text-align: center; color: #666; }
.home-load-error__retry { display: block; margin: 20rpx auto; }

.home-back-top { position: fixed; z-index: 999; top: auto; bottom: calc(124rpx + env(safe-area-inset-bottom)); right: 24rpx; width: 204rpx; height: 76rpx; margin: 0; padding: 0; font-size: 26rpx; line-height: 76rpx; color: #695941; background: #fff; border-radius: 38rpx; }
.home-back-top::after { border: 1rpx solid #ded5c5; border-radius: 38rpx; }
