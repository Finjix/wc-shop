page {
  background-color: #fff;
}

.page-container .comment-card {
  padding: 32rpx 32rpx 160rpx;
  background-color: #ffffff;
}

.comment-card .goods-info-container .goods-image {
  width: 112rpx;
  height: 112rpx;
  border-radius: 8rpx;
}

.comment-card .goods-info-container {
  display: flex;
  align-items: center;
}

.comment-card .goods-info-container .goods-title-container {
  flex: 1;
  min-width: 0;
  padding-left: 24rpx;
}

.comment-card .goods-info-container .goods-title {
  word-break: break-word;
  line-height: 40rpx;
  font-size: 28rpx;
  font-weight: normal;
}

.comment-card .goods-info-container .goods-detail {
  font-size: 24rpx;
  font-weight: normal;
  color: #999999;
  margin-top: 16rpx;
}

.rating-options {
  display: flex;
  gap: 32rpx;
  margin-top: 40rpx;
}

.rating-option {
  padding: 14rpx 44rpx;
  border: 2rpx solid #ddd;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
}

.rating-option--selected {
  color: #695941;
  border-color: #695941;
  background-color: #f2f2f2;
}

.comment-card .textarea-container {
  margin-top: 36rpx;
}

.comment-card .textarea-container .textarea {
  height: 440rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: normal;
}

.submit-button-container {
  padding: 12rpx 32rpx;
  display: flex;
  width: 100vw;
  box-sizing: border-box;
  justify-content: center;
  position: fixed;
  bottom: 0;
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  background-color: #ffffff;
  z-index: 99;
}

.submit-button-container .submit-button {
  --ui-button-color: #fff;
  --ui-button-background: #695941;
  --ui-button-border: #695941;

}

.submit-button-container .submit-button-disabled {
  --ui-button-color: #fff;
  --ui-button-background: #ccc;
  --ui-button-border: #ccc;

}

.page-container .upload-container {
  margin-top: 36rpx;
  font-size: 24rpx;
  color: #999;
}

.page-container .t-upload__wrapper {
  border-radius: 8rpx;
  overflow: hidden;
}

.page-container .submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 12;
  padding: 12rpx 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: #fff;
  height: 112rpx;
}

.page-container .submit-bar-button {
  border-radius: 48rpx !important;
  padding: 0 !important;
}

.page-container .t-upload__close-btn {
  background-color: rgba(0, 0, 0, 0.4);
  border-bottom-left-radius: 8rpx;
  width: 36rpx;
  height: 36rpx;
}

.upload-container .upload-addcontent-slot {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  color: #999;
  font-size: 24rpx;
}

.upload-addcontent-plus {
  font-size: 56rpx;
  line-height: 64rpx;
}
