@import '../../style/gift-card.wxss';
page {
  height: 100%;
  overflow: hidden;
  background-color: #fff;
}

.goods-list-page {
  display: flex;
  width: 100%;
  height: 100vh;
  flex-direction: column;
  background: #fff;
}

.goods-list-scroll {
  width: 100%;
  min-height: 0;
  flex: 1;
  background: #fff;
}

.goods-list-container {
  display: block;
  min-height: 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #fff;
}

.goods-list-navbar__title {
  color: #111 !important;
  font-size: var(--app-page-title-font-size, 34rpx) !important;
  font-weight: var(--app-page-title-font-weight, 500) !important;
}

.goods-list-header {
  position: relative;
  z-index: 3;
  flex: 0 0 auto;
  width: 100%;
  background: #fff;
}

.goods-list-toolbar {
  background: #fff;
}

.goods-list-navbar-search {
  position: absolute;
  z-index: 2;
  display: flex;
  width: 100%;
  height: 64rpx;
  min-width: 0;
  align-items: center;
  box-sizing: border-box;
}

.goods-list-navbar-search__control {
  width: 100%;
  min-width: 0;
}

.goods-list-navbar-search__input-container {
  height: 64rpx !important;
  padding: 0 24rpx !important;
  border: none !important;
  border-radius: 32rpx !important;
  background-color: #f5f5f5 !important;
}

.goods-list-navbar-search__left-icon {
  display: flex;
  align-items: center;
}

.goods-list-navbar-search__input {
  color: rgb(116, 116, 116) !important;
  font-size: 28rpx !important;
}

.goods-list-container .filter-container {
  border-bottom: 1rpx solid #f2f2f2;
}

.goods-list-container .category-goods-list {
  padding: 20rpx 0;
}

.goods-list-container .price-container {
  padding: 32rpx;
  height: 100vh;
  max-width: 632rpx;
  background-color: #fff;
  border-radius: 30rpx 0 0 30rpx;
  box-sizing: border-box;
}

.goods-list-container .price-between {
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(51, 51, 51, 1);
}

.goods-list-container .price-ipts-wrap {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 24rpx;

}

.goods-list-container .price-ipts-wrap .price-divided {
  width: 16rpx;
  margin: 0 24rpx;
  color: #333333;
}

.goods-list-container .price-ipts-wrap .t-input__wrapper {
  margin: 0 !important;
}

.goods-list-container .price-ipts-wrap .t-input__content,
.goods-list-container .price-ipts-wrap .t-input__placeholder {
  font-size: 24rpx !important;
}

.goods-list-container .price-ipts-wrap .price-ipt {
  border-radius: 8rpx;
}

.goods-list-empty {
  padding: 120rpx 32rpx;
  color: #999;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}
