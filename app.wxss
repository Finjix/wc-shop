@import 'style/iconfont.wxss';

@import 'style/theme.wxss';

page {
  background-color: #fff;
  --app-page-title-font-size: 34rpx;
  --app-page-title-font-weight: 500;
  --td-navbar-title-font-size: var(--app-page-title-font-size);
  --td-navbar-title-font-weight: var(--app-page-title-font-weight);
}

.app-page-scroll {
  display: block;
  width: 100%;
  height: 100vh;
  min-height: 0;
  box-sizing: border-box;
  background-color: #fff;
}

.app-page-navbar-title {
  font-size: var(--app-page-title-font-size, 34rpx) !important;
  font-weight: var(--app-page-title-font-weight, 500) !important;
}

.cell--noborder .t-cell::after {
  border-bottom: none !important;
}
